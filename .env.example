# =====================================================================
# Aniverse PRO — Contoh Environment Variables
# Salin file ini menjadi `.env` lalu sesuaikan:  cp .env.example .env
# Semua variabel di bawah ini memiliki default aman di kode, sehingga
# aplikasi BISA langsung jalan tanpa mengisi apa pun (Login Demo + Server Demo).
# =====================================================================

# --- Database -------------------------------------------------------
# Lokasi file SQLite (better-sqlite3, zero-config). Folder otomatis dibuat.
# Default: ./data/aniverse.db
DATABASE_PATH=./data/aniverse.db

# --- NextAuth (Autentikasi) -----------------------------------------
# Secret untuk menandatangani JWT session. WAJIB diisi di production.
# Generate:  openssl rand -base64 32
# Di development boleh dikosongkan (pakai default dev-only).
NEXTAUTH_SECRET=

# URL publik aplikasi. Untuk development cukup localhost.
# Di production ganti dengan domain asli, misal https://aniverse.example.com
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (OPSIONAL) ----------------------------------------
# Kosongkan keduanya jika hanya ingin pakai Login Demo (jalur default).
# Cara dapatkan: Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client IDs → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Provider Video (OPSIONAL) -------------------------------------
# Daftar URL base upstream provider gaya Consumet, dipisah koma ATAU JSON array.
# Contoh koma:  https://api.consumet.org,https://api-anime.vercel.app
# Contoh JSON:  ["https://api.consumet.org","https://api-anime.vercel.app"]
# Dicoba berurutan (Primary → Backup 1 → Backup 2 → ...). Jika semua gagal
# ATAU variabel dikosongkan, otomatis pakai Server Demo bawaan (selalu aktif,
# video sample bebas royalti dari Google gtv-videos-bucket).
ANIME_PROVIDERS=

# --- Sistem Kunci ---------------------------------------------------
# Jumlah kunci awal untuk user baru (default: 3).
STARTING_KEYS=3

# Durasi iklan (detik) yang wajib ditonton penuh untuk mendapat reward (default: 30).
AD_DURATION=30

# Jumlah kunci reward setelah menonton iklan penuh (default: 3).
AD_REWARD_KEYS=3

# --- XP & Level -----------------------------------------------------
# XP yang didapat per detik saat menonton (tab aktif + video playing). Default: 1.
XP_PER_SECOND=1

# Batas XP maksimal per hari (reset tengah malam). Default 7200 = 2 jam @1xp/detik.
XP_DAILY_CAP=7200

# --- Rate Limit & Keamanan ------------------------------------------
# Batas request API per menit per (IP + user). Default: 30.
RATE_LIMIT_PER_MIN=30

# Redis (OPSIONAL) untuk rate limit terdistribusi di multi-instance.
# Default (kosong): in-memory sliding window (cukup untuk single instance).
# Contoh: redis://localhost:6379
REDIS_URL=

# --- Node Environment -----------------------------------------------
# development | production. Set "production" saat build/deploy.
NODE_ENV=development

# --- Turso / libSQL (UNTUK DEPLOY VERCEL) ---------------------------
# Di Vercel filesystem read-only & SQLite tidak persisten. Untuk data
# persisten (kunci, XP, riwayat) daftar akun Turso gratis (turso.tech),
# buat database, lalu isi kedua variabel ini. Adapter @libsql/client
# pure-JS, TANPA native module, langsung jalan di Vercel.
# Jika dikosongkan di Vercel → fallback in-memory (data hilang saat cold
# start, tetap berfungsi untuk demo). Di lokal (tanpa VERCEL env) → SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
